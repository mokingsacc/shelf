[
  {
    "id": 1,
    "priority": 3,
    "action": { "type": "allow" },
    "condition": {
      "regexFilter": "^https?://([a-z0-9-]+\\.)?youtube\\.com/(signin|.*[?&]shelf=pass)",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": {
      "type": "redirect",
      "redirect": { "regexSubstitution": "https://mokingsacc.github.io/shelf/#open=\\0" }
    },
    "condition": {
      "regexFilter": "^https?://((www\\.|m\\.)?youtube\\.com/(watch|playlist)\\?.*|youtu\\.be/.+)$",
      "excludedRequestDomains": ["accounts.youtube.com", "consent.youtube.com", "music.youtube.com", "studio.youtube.com", "tv.youtube.com"],
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 3,
    "priority": 1,
    "action": { "type": "redirect", "redirect": { "url": "https://mokingsacc.github.io/shelf/" } },
    "condition": {
      "requestDomains": ["www.youtube.com", "m.youtube.com", "youtube.com"],
      "excludedRequestDomains": ["accounts.youtube.com", "consent.youtube.com", "music.youtube.com", "studio.youtube.com", "tv.youtube.com"],
      "resourceTypes": ["main_frame"]
    }
  }
]
