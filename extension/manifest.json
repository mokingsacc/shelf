{
  "manifest_version": 3,
  "name": "Shelf",
  "version": "1.0.0",
  "description": "Lets Shelf read channels, search and your YouTube history in Chrome, and sends YouTube to Shelf.",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://mokingsacc.github.io/shelf/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Shelf", "default_icon": "icon.png" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "bounce", "enabled": true, "path": "rules.json" }]
  },
  "icons": { "128": "icon.png" }
}
